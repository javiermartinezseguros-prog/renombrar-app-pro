{
  "name": "renombrar-app-pro",
  "private": true,
  "version": "1.0.13",
  "main": "main.cjs",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "electron:dev": "vite build && npx electron main.cjs",
    "electron:build": "vite build && npx electron-builder --win",
    "release": "vite build && npx electron-builder --win --publish always",
    "clean": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true})\"",
    "lint": "tsc --noEmit",
    "test": "node --import tsx --test \"tests/**/*.test.ts\""
  },
  "build": {
    "appId": "com.renombrarapp.seguros",
    "productName": "RenombrarAPP Pro",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "main.cjs",
      "preload.cjs",
      "package.json",
      "build/icon.ico",
      "release-notes.json"
    ],
    "win": {
      "target": "nsis",
      "icon": "build/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    },
    "publish": {
      "provider": "github",
      "owner": "javiermartinezseguros-prog",
      "repo": "renombrar-app-pro"
    }
  },
  "dependencies": {
    "chokidar": "^4.0.3",
    "electron-updater": "^6.8.9"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.1.14",
    "@tesseract.js-data/spa": "^1.0.0",
    "@types/node": "^22.14.0",
    "@vitejs/plugin-react": "^5.0.4",
    "electron": "^44.0.0",
    "electron-builder": "^26.15.3",
    "jszip": "^3.10.1",
    "lucide-react": "^0.546.0",
    "motion": "^12.23.24",
    "pdfjs-dist": "^6.3.289",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "tailwindcss": "^4.1.14",
    "tesseract.js": "^7.0.0",
    "tsx": "^4.21.0",
    "typescript": "~5.8.2",
    "vite": "^6.2.3"
  }
}
